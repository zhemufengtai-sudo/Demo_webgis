<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<ModelClass name="SCS模型的降雨-径流关系模型" uid="06f1f723-956f-445e-befd-00d357607d26" type="SimpleCalculation">
  <AttributeSet>
    <Categories>
      <Category principle="Resource Environment Math Model" path="VGE Model" />
    </Categories>
    <LocalAttributes>
      <LocalAttribute local="EN_US" localName="SCS模型的降雨-径流关系模型" wiki="">
        <Keywords></Keywords>
        <Abstract></Abstract>
      </LocalAttribute>
      <LocalAttribute local="ZH_CN" localName="SCS模型的降雨-径流关系模型" wiki="">
        <Keywords></Keywords>  
        <Abstract></Abstract>
      </LocalAttribute>
    </LocalAttributes>
  </AttributeSet>
  <Behavior>
    <RelatedDatasets>
     <DatasetItem name="inputdata" type="internal" description="inputdata">
        <UdxDeclaration>
		  <UDXNode>
                        <UDXNode name="P" type="DTKT_REAL" description="一次降雨的降雨总量" />
            <UDXNode name="S" type="DTKT_REAL" description="流域当时的最大可能滞留量" />

          </UDXNode>
        </UdxDeclaration>
      </DatasetItem>
	  <DatasetItem name="outputdata" type="internal" description="outputdata">
        <UdxDeclaration>
		  <UDXNode>
                        <UDXNode name="double" type="DTKT_REAL" description="径流量" />

          </UDXNode>
        </UdxDeclaration>
      </DatasetItem>
    </RelatedDatasets>
    <StateGroup>
      <States>
        <State id="04fcb904-270c-4dba-8505-016004fe5d02" name="LOADDATA" type="basic" description="Model load data">
          <Event name="inputdata" type="response" description="Load Input data" optional="False" >
            <ResponseParameter datasetReference="inputdata" description="" />
          </Event>
        </State>
        <State id="84da3376-366f-45cf-b6d4-78a5d1ce7dd6" name="RETURNDATA" type="basic" description="Model start to running And Return data">
          <Event name="Output" type="noresponse" description="Return output data">
            <DispatchParameter datasetReference="outputdata" description="" />
          </Event>
        </State>
      </States>
      <StateTransitions />
    </StateGroup>
  </Behavior>
  <Runtime name="Resource Environment Math Model" version="1.0" baseDir="$(ModelServicePath)\model" entry="YTX.exe">
    <HardwareConfigures>
      <Add key="Main Frequency" value="2.8" />
    </HardwareConfigures>
    <SoftwareConfigures>
      <Add key="Operation Platform" value="Windows" />
      <Add key="Language Platform" value="C++ 2015" />
    </SoftwareConfigures>
    <Assemblies>
    </Assemblies>
    <SupportiveResources>
    </SupportiveResources>
  </Runtime>
</ModelClass>